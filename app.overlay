// #include <zephyr/dt-bindings/sensor/lsm6dsv16x.h>

&pinctrl {
	spim21_default: spim21_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 5)>,
					<NRF_PSEL(SPIM_MOSI, 1, 6)>,		
					<NRF_PSEL(SPIM_MISO, 1, 7)>;
		};
	};

	spim21_sleep: spim21_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 5)>,
					<NRF_PSEL(SPIM_MOSI, 1, 6)>,		
					<NRF_PSEL(SPIM_MISO, 1, 7)>;
			low-power-enable;
		};
	};
};

&spi21 {
	status = "okay";
	pinctrl-0 = <&spim21_default>;
	pinctrl-1 = <&spim21_sleep>;
	pinctrl-names = "default", "sleep";

	cs-gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;

	lsm6dsv32x_0: lsm6dsv32x@0 {
		compatible = "st,lsm6dsv32x";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <4000000>;
		spi-cpol;
		spi-cpha;

		// accel-range = <LSM6DSV16X_DT_FS_8G>;
		// accel-odr = <LSM6DSV16X_DT_ODR_AT_60Hz>;
		// gyro-range = <LSM6DSV16X_DT_FS_4000DPS>;
		// gyro-odr = <LSM6DSV16X_DT_ODR_AT_60Hz>;
	};
};

/ {
	aliases {
		imu0 = &lsm6dsv32x_0;
	};
};
